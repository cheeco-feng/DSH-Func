{
  "name": "@cheeco/dsh-client-ui-webgate",
  "description": "会话控制台：指定一个会话 id 查看对话历史、发消息、实时刷新（Cheeco 独立插件页）。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "runtime": {
        "range": ">=0.1.1-rc.1 <0.2.0",
        "evidence": {
          "providerId": "dsh-cli-provider-v1",
          "runtime": "0.1.1-rc.1",
          "verifiedAt": "2026-09-01",
          "matrixArtifact": "runtime-support/supported-runtimes.json"
        }
      },
      "surfaces": [
        "main"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "cheecoPanel": {
      "addPage": {
        "id": "webgate",
        "label": "会话控制台",
        "page": "@cheeco/dsh-client-ui-webgate",
        "blocks": []
      }
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {}
}

{
  "name": "@cheeco/dsh-cmdwatch",
  "version": "0.1.0",
  "description": "Cheeco 命令窗：实时显示 dsh 发起的命令内容与执行输出，无需暂停对话即可查看进度。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "runtime": {
        "range": ">=0.1.1-rc.1 <0.2.0",
        "evidence": {
          "providerId": "dsh-cli-provider-v1",
          "runtime": "0.1.1-rc.1",
          "desktop": "3.1.0",
          "verifiedAt": "2026-09-01",
          "matrixArtifact": "runtime-support/supported-runtimes.json"
        }
      },
      "surfaces": [
        "main"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "^0.1.1-rc.2"
  }
}

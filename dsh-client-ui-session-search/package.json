{
  "name": "@cheeco/dsh-client-ui-session-search",
  "version": "0.1.0",
  "description": "Cheeco 的 DSH 会话搜索小功能：侧边栏搜索入口，标题 ↔ 内容一键切换，按会话聚合展示标题与命中片段。",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "desktop": {
        "range": ">=2.7.0 <4.0.0",
        "api": "^1.2.0"
      },
      "runtime": {
        "range": ">=0.1.1-rc.1 <0.2.0",
        "evidence": {
          "providerId": "dsh-cli-provider-v1",
          "runtime": "0.1.1-rc.1",
          "desktop": "3.1.0",
          "verifiedAt": "2026-08-28",
          "matrixArtifact": "runtime-support/supported-runtimes.json"
        }
      },
      "surfaces": [
        "main"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}

{
  "name": "@cheeco/dsh-web-ui-cheeco-style",
  "version": "0.8.26",
  "description": "DSH功能套装（未整理小功能）：Cheeco 设置数据底座——提供 /cheeco-style/config、/cheeco-style/assets 路由与 cheeco-config-change/cheeco-brand-change 事件，并负责顶部品牌名/Logo 显示。不显示任何侧边栏（各功能已迁到对应宿主包侧边栏）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "desktop": {
        "range": ">=2.0.0",
        "api": "^1.0.0"
      },
      "runtime": {
        "range": ">=0.1.0",
        "evidence": {
          "providerId": "dsh-cli-provider-v1",
          "runtime": "0.1.0",
          "desktop": "2.0.0",
          "verifiedAt": "2026-08-28",
          "matrixArtifact": "runtime-support/supported-runtimes.json"
        }
      },
      "surfaces": [
        "main"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {}
}

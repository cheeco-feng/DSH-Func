{
  "name": "@cheeco/dsh-client-ui-session-deeplink",
  "description": "深链接：通过 URL 参数（?session= / ?cwd= / ?workspace=，可 & 拼接）打开指定会话或工作区，并让地址栏始终与当前会话同步；并在会话 url 生成处通过 dsh-session-deeplink:url 事件暴露「当前 url」变量（Cheeco 独立插件）。",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "runtime": {
        "range": ">=0.1.1-rc.1 <0.2.0",
        "evidence": {
          "providerId": "dsh-cli-provider-v1",
          "runtime": "0.1.1-rc.1",
          "verifiedAt": "2026-09-01",
          "matrixArtifact": "runtime-support/supported-runtimes.json"
        }
      },
      "surfaces": [
        "main"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "license": "MIT",
  "peerDependencies": {}
}

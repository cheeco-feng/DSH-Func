{
  "name": "@cheeco/dsh-client-ui-session-deeplink",
  "description": "深链接：通过 URL 参数（?session= / ?cwd= / ?workspace=，可 & 拼接）打开指定会话或工作区，并让地址栏始终与当前会话同步；并在 package.json 的 dsh.cheecoMoreCards 声明「打开当前会话」更多菜单卡，由 WindowSlot-Panel 同步进 cheeco-registry.json（卸载自动清除）（Cheeco 独立插件）。",
  "version": "0.1.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "runtime": {
        "range": ">=0.1.1-rc.1 <0.2.0",
        "evidence": {
          "providerId": "dsh-cli-provider-v1",
          "runtime": "0.1.1-rc.1",
          "verifiedAt": "2026-09-01",
          "matrixArtifact": "runtime-support/supported-runtimes.json"
        }
      },
      "surfaces": [
        "main"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "cheecoMoreCards": [
      { "id": "open-current-session", "label": "打开当前会话", "desc": "在新窗口打开当前会话", "type": "open", "url": "{origin}/?session={session}", "order": 1 }
    ]
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "license": "MIT",
  "peerDependencies": {}
}

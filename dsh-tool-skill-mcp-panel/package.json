{
  "name": "@cheeco/dsh-tool-skill-mcp-panel",
  "version": "0.1.0",
  "description": "dsh-tool-skill-mcp-panel: 保留 dsh-skill-mcp-panel 全部功能（技能管理 + MCP 管理 + dsh-panel CLI），并集成「技能(选择)/常驻技能列表」两个 tab，注入「能力」包（dsh-web-ui-PowerPackagePanel）的子 slot。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^5.0.0"
  },
  "bin": {
    "dsh-panel": "./lib/cli.js"
  },
  "scripts": {},
  "files": [
    "lib",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml"
  ]
}